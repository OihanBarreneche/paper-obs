# Python
__pycache__/
*.py[cod]
.venv/
.venv-win/
.uv-cache/
*.egg-info/
.pytest_cache/
.pytest-tmp*/
.coverage
htmlcov/

# Node (frontend, apps/web)
node_modules/
dist/
.vite/

# Local runs and artefacts; the shipped examples are published
runs/
!examples/runs/
*.writing
out/
*.local.json
.private/
# Legacy local submission packages; new dossiers live under .private/submissions/.
/submissions/
# Keep local builders private; publish the repeatable reference refresh tools.
/scripts/*
!/scripts/build_packing_catalog.py
!/scripts/build_squares_records.py
!/scripts/update_catalog.py

# Secrets (LLM providers)
.env
.env.*
!.env.example

# Python sandbox: Deno, its cache and Pyodide (local only)
.sandbox/
